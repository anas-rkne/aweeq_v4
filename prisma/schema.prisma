  @@schema("commerce")
}

model OrderItemProfile {
  id             String   @id @db.Text
  order_id       String   @db.Text
  order_item_id  String   @unique @db.Text
  product_id     String?  @db.Text
  variant_id     String?  @db.Text
  serial_unit_id String?  @unique @db.Text
  civilization_id String? @db.Text
  metadata       Json     @default(dbgenerated("'{}'::jsonb")) @db.JsonB
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([order_id])
  @@map("order_item_profile")
  @@schema("commerce")
}

model Preorder {
  id                String    @id @db.Text
  customer_id       String?   @db.Text
  email             String    @db.Text
  product_id        String    @db.Text
  variant_id        String    @db.Text
  drop_id           String?   @db.Text
  quantity          Int       @default(1)
  status            String    @default("pending") @db.Text
  payment_intent_id String?   @db.Text
  expires_at        DateTime? @db.Timestamptz(6)
  converted_order_id String?  @db.Text
  metadata          Json      @default(dbgenerated("'{}'::jsonb")) @db.JsonB
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, expires_at])
  @@map("preorder")
  @@schema("commerce")
}

// ---------------------------------------------------------------------------
// content
// ---------------------------------------------------------------------------

model JournalPost {
  id              String    @id @db.Text
  slug            String    @unique @db.Text
  civilization_id String?   @db.Text
  product_id      String?   @db.Text
  status          String    @default("draft") @db.Text
  cover_media_id  String?   @db.Text
  author_name     String?   @db.Text
  reading_minutes Int?
  tags            String[]  @default([])
  published_at    DateTime? @db.Timestamptz(6)
  title_ar        String    @db.Text
  title_en        String    @db.Text
  excerpt_ar      String?   @db.Text
  excerpt_en      String?   @db.Text
  body_ar         String?   @db.Text
  body_en         String?   @db.Text
  metadata        Json      @default(dbgenerated("'{}'::jsonb")) @db.JsonB
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)

  @@index([status, published_at])
  @@index([civilization_id])
  @@map("journal_post")
  @@schema("content")
}

// ---------------------------------------------------------------------------
// ops
// ---------------------------------------------------------------------------

model WebhookEvent {
  id          String    @id @db.Text
  provider    String    @db.Text
  external_id String?   @db.Text
  event_type  String    @db.Text
  payload     Json      @db.JsonB
  headers     Json      @default(dbgenerated("'{}'::jsonb")) @db.JsonB
  status      String    @default("received") @db.Text
  attempts    Int       @default(0)
  last_error  String?   @db.Text
  received_at DateTime  @default(now()) @db.Timestamptz(6)
  processed_at DateTime? @db.Timestamptz(6)

  @@index([provider, external_id])
  @@index([status, received_at])
  @@map("webhook_event")
  @@schema("ops")
}

model OutboxEvent {
  id             String    @id @db.Text
  aggregate_type String    @db.Text
  aggregate_id   String    @db.Text
  event_type     String    @db.Text
  payload        Json      @default(dbgenerated("'{}'::jsonb")) @db.JsonB
  status         String    @default("pending") @db.Text
  attempts       Int       @default(0)
  available_at   DateTime  @default(now()) @db.Timestamptz(6)
  last_error     String?   @db.Text
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  published_at   DateTime? @db.Timestamptz(6)

  @@index([status, available_at])
  @@map("outbox_event")
  @@schema("ops")
}

model IdempotencyKey {
  key             String    @id @db.Text
  scope           String    @db.Text
  request_hash    String?   @db.Text
  response_status Int?
  response_body   Json?     @db.JsonB
  status          String    @default("in_progress") @db.Text
  locked_until    DateTime? @db.Timestamptz(6)
  expires_at      DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([expires_at])
  @@map("idempotency_key")
  @@schema("ops")
}

model AuditLog {
  id          String   @id @db.Text
  actor_id    String?  @db.Text
  actor_type  String   @default("system") @db.Text
  action      String   @db.Text
  entity_type String   @db.Text
  entity_id   String   @db.Text
  before      Json?    @db.JsonB
  after       Json?    @db.JsonB
  ip          String?  @db.Inet
  user_agent  String?  @db.Text
  metadata    Json     @default(dbgenerated("'{}'::jsonb")) @db.JsonB
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([entity_type, entity_id, created_at])
  @@index([actor_type, actor_id, created_at])
  @@map("audit_log")
  @@schema("ops")
}
