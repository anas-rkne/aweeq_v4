{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", ".medusa/types/**/*.ts"],
  "exclude": ["node_modules", "dist", ".medusa"],
  "ts-node": {
    "transpileOnly": true
  }
}
