# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# impeccable — engine binary is fetched per platform, never tracked (~20MB)
**/skills/impeccable/scripts/bin/
# impeccable — local runtime state only; config.json stays tracked
.impeccable/live/
.impeccable/history/
.impeccable/config.local.json

# taste-skill — runtime artefacts only (screenshots, inspect reports); the skill itself is tracked
.taste-skill/
# skills CLI duplicate install path (canonical copy lives in .opencode/skills/)
.agents/
# local dev log
.opencode/dev.log

# medusa backend
/medusa/node_modules
/medusa/.medusa
/medusa/dist
/medusa/static/uploads
/medusa/.env
/medusa/.env.*
/medusa/package-lock.json
!/medusa/.env.template

# local logs
*.log

# local runtime data (newsletter queue, dev caches)
/.data/

# local asset backups (originals kept outside the app)
/.asset-backup/

# OS / editor files
Thumbs.db
.idea/
.vscode/
